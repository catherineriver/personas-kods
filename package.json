    "url": "https://github.com/catherineriver/personas-kods/issues"
  },
  "keywords": [
    "latvia",
    "latvian",
    "personas kods",
    "personas-kods",
    "personal code",
    "personal id code",
    "personal identification code",
    "personal identity number",
    "national identity number",
    "national id",
    "tax id",
    "tin",
    "id validator",
    "validator",
    "check digit",
